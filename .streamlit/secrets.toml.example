# Copy this file to  .streamlit/secrets.toml  and fill in the values.
# On Streamlit Community Cloud, paste the same keys under
#   Manage app -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is git-ignored).

MONDAY_API_TOKEN = "paste-your-monday-api-v2-token"
MONDAY_API_VERSION = "2024-10"

# Numeric board IDs (from the board URL: /boards/<ID>)
DEALS_BOARD_ID = "0000000000"
WORK_ORDERS_BOARD_ID = "0000000000"

# LLM: OpenAI-compatible endpoint. Defaults target NVIDIA NIM (Nemotron).
LLM_API_KEY = "nvapi-..."
LLM_BASE_URL = "https://integrate.api.nvidia.com/v1"
LLM_MODEL = "nvidia/nemotron-3-ultra-550b-a55b"

# Optional tuning
CACHE_TTL_SECONDS = "300"
FISCAL_YEAR_START_MONTH = "4"   # 4 = April (Indian FY). Use 1 for calendar year.
